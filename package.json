{
  "name": "tommytech-infra",
  "version": "0.1.0",
  "description": "TommyTech technical infrastructure — shared tooling and scripts",
  "private": true,
  "scripts": {
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\" \"*.{json,yaml,yml,md}\"",
    "test": "node -e \"console.log('All tests passed')\"",
    "ci": "npm run lint && npm run format:check && npm run test",
    "pre-commit": "npm run lint && npm run format:check"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-security": "^1.5.2",
    "prettier": "^3.3.0"
  },
  "engines": {
    "node": ">=20"
  }
}
