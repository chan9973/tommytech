# ============================================
# TommyTech .gitignore - Comprehensive
# ============================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/
*.manifest
*.pyc
# Virtual environments
venv/
.venv/
env/
.env
.env.*
!_.env.example
!.env.example
# pytest
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
# mypy / pyright
.mypy_cache/
.pyright/
.pytype/
# Jupyter
.ipynb_checkpoints
# pip
pip-wheel-metadata/
# Poetry
poetry.lock
# pipenv
Pipfile.lock
# PyInstaller
*.spec
# Coverage
.coverage.* coverage.xml

# --- Node.js ---
node_modules/
bower_components/
jspm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# Next.js / React build output
.next/
.nuxt/
dist/
out/
# Environment
.env.local
.env.production
.env.staging
.env.test
# pnpm
pnpm-debug.log*
.pnpm-store/

# --- OS / Editor ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
# IDEs
.idea/
.vscode/
*.swp
*.swo
*~
# vim
*.un~
# Emacs
*~
\#*\#
.\#*

# --- Docker ---
*.pid
*.lock
# Docker Compose environment
docker-compose.override.yml

# --- Secrets / Credentials ---
# Never commit secrets
*.key
*.pem
*.crt
*.cert
*.p12
*.pfx
credentials.json
service-account.json
*.tfvars
.terraform/
.sops.yaml

# --- Build / Misc ---
*.log
logs/
.tmp/
.tmp/
.cache/
.temp/
