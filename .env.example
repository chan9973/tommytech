# TommyTech Environment Variables
# Copy to .env and fill in real values.
# NEVER commit .env to version control.

# ── Application ──
TOMMTECH_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false

# ── Server ──
HOST=0.0.0.0
PORT=8000
WORKERS=4

# ── Database ──
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/tommytech

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── Security ──
SECRET_KEY=CHANGE_ME_TO_A_SECURE_RANDOM_KEY
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
ENCRYPTION_KEY=CHANGE_ME_32_CHAR_ENCRYPTION_KEY

# ── External Services ──
# API keys for external integrations
# TOMMTECH_API_KEY=
